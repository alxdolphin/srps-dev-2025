## SRPS Toolkit example environment
## Copy to .env and fill in real values. Do not commit .env.

# DonorPerfect XML API
DP_API_URL="https://www.donorperfect.net/prod/xmlrequest.asp"
DP_API_KEY="REPLACE_ME"

# Optional: override flag codes used by donorperfect tag-running-leaders
DP_ACTIVE_FLAG_CODE="RL"
DP_FORMER_FLAG_CODE="FRL"
